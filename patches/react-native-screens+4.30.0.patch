+NS_ASSUME_NONNULL_BEGIN
+
+/** Keeps UIKit's bottom-edge binding in sync with visible lists inside horizontal pagers. */
+@interface RNSTabContentScrollViewTracker : NSObject
+- (instancetype)initWithViewController:(UIViewController *)viewController;
+- (nullable UIScrollView *)resolveScrollView;
+- (void)setActive:(BOOL)active;
+- (void)setNeedsUpdate;
+@end
+
+NS_ASSUME_NONNULL_END
