@@ -0,0 +1,110 @@
+#import "RNSTabContentScrollViewTracker.h"
+#import "RNSScrollViewFinder.h"
+
+static void *RNSTabScrollContainerObservation = &RNSTabScrollContainerObservation;
+
+@implementation RNSTabContentScrollViewTracker {
+  __weak UIViewController *_viewController;
+  __weak UIScrollView *_boundScrollView;
+  NSMutableSet<UIScrollView *> *_observedContainers;
+  BOOL _active;
+  BOOL _updateScheduled;
+  BOOL _hasBoundScrollView;
+}
+
+- (instancetype)initWithViewController:(UIViewController *)viewController
+{
+  if (self = [super init]) {
+    _viewController = viewController;
+    _observedContainers = [NSMutableSet new];
+  }
+  return self;
+}
+
+- (nullable UIScrollView *)resolveScrollView
+{
+  return [RNSScrollViewFinder findVisibleVerticalScrollViewFrom:_viewController.viewIfLoaded
+                                                  preferred:_boundScrollView
+                                       horizontalContainers:nil];
+}
+
+- (void)setObservedContainers:(NSSet<UIScrollView *> *)containers
+{
+  for (UIScrollView *scrollView in _observedContainers) {
+    if (![containers containsObject:scrollView]) {
+      [scrollView removeObserver:self forKeyPath:@"bounds" context:RNSTabScrollContainerObservation];
+      [scrollView removeObserver:self forKeyPath:@"contentSize" context:RNSTabScrollContainerObservation];
+    }
+  }
+  for (UIScrollView *scrollView in containers) {
+    if (![_observedContainers containsObject:scrollView]) {
+      [scrollView addObserver:self forKeyPath:@"bounds" options:0 context:RNSTabScrollContainerObservation];
+      [scrollView addObserver:self forKeyPath:@"contentSize" options:0 context:RNSTabScrollContainerObservation];
+    }
+  }
+  _observedContainers = [containers mutableCopy];
+}
+
+- (void)setActive:(BOOL)active
+{
+  _active = active;
+  if (active) {
+    [self setNeedsUpdate];
+  } else {
+    _hasBoundScrollView = NO;
+    [self setObservedContainers:[NSSet new]];
+  }
+}
+
+- (void)setNeedsUpdate
+{
+  if (!_active || _updateScheduled) {
+    return;
+  }
+  _updateScheduled = YES;
+  __weak RNSTabContentScrollViewTracker *weakSelf = self;
+  dispatch_async(dispatch_get_main_queue(), ^{
+    RNSTabContentScrollViewTracker *strongSelf = weakSelf;
+    if (strongSelf == nil) {
+      return;
+    }
+    strongSelf->_updateScheduled = NO;
+    if (strongSelf->_active) {
+      [strongSelf updateBinding];
+    }
+  });
+}
+
+- (void)updateBinding
+{
+  NSMutableSet<UIScrollView *> *containers = [NSMutableSet new];
+  UIScrollView *scrollView = [RNSScrollViewFinder findVisibleVerticalScrollViewFrom:_viewController.viewIfLoaded
+                                                                     preferred:_boundScrollView
+                                                          horizontalContainers:containers];
+  [self setObservedContainers:containers];
+  if (!_hasBoundScrollView || scrollView != _boundScrollView) {
+    _hasBoundScrollView = YES;
+    _boundScrollView = scrollView;
+    // The getter alone does not invalidate UIKit's existing scroll observation after a horizontal swipe.
+    [_viewController setContentScrollView:scrollView forEdge:NSDirectionalRectEdgeBottom];
+  }
+}
+
+- (void)observeValueForKeyPath:(NSString *)keyPath
+                     ofObject:(id)object
+                       change:(NSDictionary<NSKeyValueChangeKey, id> *)change
+                      context:(void *)context
+{
+  if (context == RNSTabScrollContainerObservation) {
+    [self setNeedsUpdate];
+  } else {
+    [super observeValueForKeyPath:keyPath ofObject:object change:change context:context];
+  }
+}
+
+- (void)dealloc
+{
+  [self setObservedContainers:[NSSet new]];
+}
+
+@end
