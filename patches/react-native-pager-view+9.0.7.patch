@@ -0,0 +1,22 @@
+package com.reactnativepagerview
+
+internal data class PendingPageCommand(val page: Int, val animated: Boolean)
+
+/** Latest command for the next UI turn, after Fabric's child mount operations. */
+internal class PendingPageCommandQueue {
+  private var pending: PendingPageCommand? = null
+
+  fun enqueue(page: Int, animated: Boolean) {
+    if (page >= 0) pending = PendingPageCommand(page, animated)
+  }
+
+  fun drain(pageCount: Int): PendingPageCommand? {
+    val command = pending
+    pending = null
+    return command?.takeIf { it.page in 0 until pageCount }
+  }
+
+  fun clear() {
+    pending = null
+  }
+}
