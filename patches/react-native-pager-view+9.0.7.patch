@@ -0,0 +1,49 @@
+package com.reactnativepagerview
+
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertNull
+import org.junit.Test
+
+class PendingPageCommandQueueTest {
+  @Test
+  fun commandUsesThePageCountAfterTheMountTransaction() {
+    val commands = PendingPageCommandQueue()
+    // Only the selected answer existed when JS issued this command. Its list
+    // inserts three preceding pages before the posted native command is drained.
+    commands.enqueue(3, false)
+    assertEquals(PendingPageCommand(3, false), commands.drain(4))
+    assertNull(commands.drain(4))
+  }
+
+  @Test
+  fun obsoleteCommandsCannotOverrideTheLatestNavigation() {
+    val commands = PendingPageCommandQueue()
+    commands.enqueue(3, false)
+    commands.enqueue(1, true)
+    assertEquals(PendingPageCommand(1, true), commands.drain(4))
+  }
+
+  @Test
+  fun invalidCommandDoesNotBecomeADeferredJumpAfterPagination() {
+    val commands = PendingPageCommandQueue()
+    commands.enqueue(4, false)
+    assertNull(commands.drain(4))
+    assertNull(commands.drain(5))
+  }
+
+  @Test
+  fun aGestureOrPagerResetCancelsTheQueuedCommand() {
+    val commands = PendingPageCommandQueue()
+    commands.enqueue(3, false)
+    commands.clear()
+    assertNull(commands.drain(4))
+  }
+
+  @Test
+  fun negativeCommandsAreIgnored() {
+    val commands = PendingPageCommandQueue()
+    commands.enqueue(1, false)
+    commands.enqueue(-1, true)
+    assertEquals(PendingPageCommand(1, false), commands.drain(4))
+  }
+}
