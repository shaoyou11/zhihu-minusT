# Keep this file aligned with .gitignore. EAS uses .easignore instead of
# .gitignore when creating the local/cloud build archive.

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local
.env

# Firebase client configuration is generated by GitHub Actions before EAS.
/google-services.json
/GoogleService-Info.plist

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android
/build
/modules/*/android/.gradle/
/modules/*/android/build/

# These exceptions must stay last so they override the Firebase rules above.
!/google-services.json
!/GoogleService-Info.plist
